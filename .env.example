# =============================================================
# Garmin Connect & AI Running Coach Environment Configuration
# =============================================================

# 1. Garmin Connect Authentication
# สำหรับการล็อกอินครั้งแรกผ่าน connect_garmin.py เพื่อสร้าง Session Token
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Base64 Token ที่ได้จากการรัน python export_tokens.py (สำหรับ Deploy บน Cloud / Render)
GARMIN_TOKENS_BASE64=

# 2. LINE Messaging API (LINE Developers Console)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ระบุ LINE User ID ของเจ้าของบัญชี (Uxxxxxxxx...) เพื่อรับ Push Notification รายวัน
LINE_ALLOWED_USER_ID=your_line_user_id_here

# 3. Google Gemini AI (Google AI Studio)
# สำหรับระบบวิเคราะห์การซ้อม, ให้คำแนะนำ และออกแบบตารางซ้อมอัตโนมัติ
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Webhook Server & Token Sync Configuration
PORT=8000
RENDER_APP_URL=https://your-service-name.onrender.com
TOKEN_UPDATE_SECRET=your_custom_secure_secret_key_here
